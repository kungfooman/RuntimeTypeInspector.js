{
  "name": "@rti/jsdoc-template",
  "version": "1.1.2",
  "description": "RTI JSDoc template — vendored PlayCanvas template redesigned for RuntimeTypeInspector.js (typed string templates, no Handlebars/catharsis, issue #72)",
  "author": "RuntimeTypeInspector.js",
  "homepage": "https://github.com/kungfooman/RuntimeTypeInspector.js",
  "keywords": ["rti", "jsdoc", "template", "runtime-type-inspector"],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kungfooman/RuntimeTypeInspector.js/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kungfooman/RuntimeTypeInspector.js.git"
  },
  "eslintConfig": {
    "extends": "@playcanvas/eslint-config"
  },
  "scripts": {
    "build": "sass --no-source-map sass/styles.scss static/styles/styles.css",
    "lint": "eslint publish.js static/scripts/site/*",
    "test": "npm run lint"
  },
  "files": [
    "LICENSE",
    "package.json",
    "publish.js",
    "README.md",
    "static",
    "tmpl"
  ],
  "devDependencies": {
    "@jsdoc/salty": "^0.2.5",
